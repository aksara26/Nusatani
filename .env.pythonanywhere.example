# Salin file ini menjadi `.env` di folder proyek di PythonAnywhere.
# Ganti <username> dengan username akun PythonAnywhere Anda.

SECRET_KEY=5ZHglOFHs1DPye382L8iiR6MBT--Eu_oh1SDNynebLMAB7zYm0ubIkRs1Vc3-EniuwL63M2EntHvmnWXpCPcig
DEBUG=False
ALLOWED_HOSTS=<username>.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://<username>.pythonanywhere.com

# Akun PythonAnywhere Beginner baru tidak menyediakan PostgreSQL gratis.
# Kosongkan DATABASE_URL agar Django memakai SQLite.
DATABASE_URL=

# HTTPS diurus oleh PythonAnywhere (aktifkan Force HTTPS di tab Web).
# Jangan aktifkan SECURE_SSL_REDIRECT di sini agar tidak terjadi redirect loop.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
